# Supabase project (created by Brendan — see docs/PHASE_0_PLAN.md "What Brendan Must Do")
DATABASE_URL=                  # Supabase Postgres connection string (pooled, for the app runtime)
DATABASE_URL_DIRECT=           # Supabase direct connection string (for drizzle-kit migrations)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=     # server-side only, never exposed to the client — used to upload rendered pin images (src/lib/storage.ts)
SUPABASE_ANON_KEY=
# Also requires a public Storage bucket named "content-assets" created once in the Supabase dashboard

# Auth
ADMIN_EMAIL=                   # the only email allowed to sign in (magic link)

# Shopify (custom app created in Shopify admin — Settings > Apps > Develop apps)
SHOPIFY_SHOP_DOMAIN=verygoodfireplaces.com
SHOPIFY_BLOG_HANDLE=electric-fireplaces   # confirmed against the real store during Phase 0 — used to build public article URLs for Pinterest/Facebook links
SHOPIFY_ADMIN_API_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# Anthropic
ANTHROPIC_API_KEY=

# This deployment's own public URL, used to build OAuth redirect URIs
# (must exactly match what's registered in the Pinterest/Meta developer apps)
APP_BASE_URL=https://your-deployment.vercel.app

# Pinterest (set once Developer app + API access is approved) — connect via /api/oauth/pinterest/start
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# Meta / Facebook + Instagram (set once Developer app exists) — connect via /api/oauth/meta/start
META_APP_ID=
META_APP_SECRET=

# Cron endpoint auth (Vercel Cron sends this header; reject requests without it)
CRON_SECRET=
